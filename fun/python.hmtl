<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Output</title>
<style>
  body { margin: 0; padding: 16px; font-family: monospace; }
  pre { margin: 0; white-space: pre-wrap; word-wrap: break-word; }
</style>
</head>
<body>
<pre id="out"></pre>
<script>
  fetch('/run')
    .then(r => r.text())
    .then(t => { document.getElementById('out').textContent = t; });
</script>
</body>
</html>
